# Connection to the hosted PostgreSQL warehouse.
#
# Copy to `.env` and fill in. `tools/setup-warehouse-server.sh` prints this block
# filled out for you when it finishes. `.env` is gitignored and must stay that way —
# it holds a live credential.
#
# Anything exported in your real environment wins over this file, so CI can inject
# PGPASSWORD without a stale .env overriding it.

PGHOST=your-server-hostname
PGPORT=5432
PGDATABASE=mva
PGUSER=mva
PGPASSWORD=

# Ingested source tables land here; `pg-ingest` replaces this schema wholesale.
PGSCHEMA=warehouse

# Derived results land here; ingest never touches it.
PGRESULTSCHEMA=results

# Optional: the SSH target for the file-based warehouse verbs (push/load/ship).
# Not needed for the Postgres path, which connects over the network.
#MVA_WAREHOUSE_HOST=user@your-server-hostname

# ── Object store (MinIO on the server) ──────────────────────────────────────
# Where the bulk files live. DuckDB reads these over HTTP range requests, so a
# query transfers only the bytes it needs — nothing is downloaded whole.
# `tools/setup-object-store.sh` prints these filled in. The port here is the one
# PUBLISHED on the host (9002 by default), never MinIO's internal 9000.
# Use the server's hostname — `localhost` is only correct while an SSH tunnel
# is open ON THIS MACHINE.
S3_ENDPOINT=your-server-hostname:9002
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mva

# Set false only while testing over plain HTTP on a trusted network.
S3_USE_SSL=true
