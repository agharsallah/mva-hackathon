#!/usr/bin/env sh
# Husky pre-push hook — root-level for the same reason as pre-commit (git
# resolves core.hooksPath from the repo top level, and this hook needs to see
# every ref being pushed, not just app/'s subtree).
#
# Runs the full app/ gate (`npm run check` + build) once for the whole push,
# but only when the range being pushed actually touches app/ — a Python-only
# or docs-only push is not slowed down by npm/node at all. git passes one
# "<local ref> <local sha1> <remote ref> <remote sha1>" line per pushed ref on
# stdin; any ambiguous case (new branch, first-ever push) falls back to
# running the gate rather than silently skipping it.
set -e

zero=0000000000000000000000000000000000000000
run_gate=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue # deleting the ref — nothing to check

  if [ "$remote_sha" = "$zero" ]; then
    # New ref: no remote history to diff against. Compare to the merge-base
    # with the default remote branch instead; if even that is unavailable
    # (e.g. the very first push of the repo), diff the full tree so the gate
    # runs rather than being skipped.
    default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
    base=$(git merge-base "$local_sha" "$default_branch" 2>/dev/null || true)
    if [ -n "$base" ]; then
      changed=$(git diff --name-only "$base" "$local_sha")
    else
      empty_tree=$(git hash-object -t tree /dev/null)
      changed=$(git diff --name-only "$empty_tree" "$local_sha")
    fi
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha")
  fi

  if printf '%s\n' "$changed" | grep -q '^app/'; then
    run_gate=1
  fi
done

if [ "$run_gate" = "0" ]; then
  echo "pre-push: no app/ changes in the pushed range — skipping npm run check + build"
  exit 0
fi

echo "pre-push: app/ changes detected — running npm run check + build"
cd app
npm run check
npm run build
