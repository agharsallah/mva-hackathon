# Connection to the hosted PostgreSQL warehouse.
#
# Copy to `.env` and fill in. `tools/setup-warehouse-server.sh` prints this block
# filled out for you when it finishes. `.env` is gitignored and must stay that way —
# it holds a live credential.
#
# Anything exported in your real environment wins over this file, so CI can inject
# PGPASSWORD without a stale .env overriding it.

PGHOST=your-server-hostname
PGPORT=5432
PGDATABASE=mva
PGUSER=mva
PGPASSWORD=

# Ingested source tables land here; `pg-ingest` replaces this schema wholesale.
PGSCHEMA=warehouse

# Derived results land here; ingest never touches it.
PGRESULTSCHEMA=results

# Optional: the SSH target for the file-based warehouse verbs (push/load/ship).
# Not needed for the Postgres path, which connects over the network.
#MVA_WAREHOUSE_HOST=user@your-server-hostname

# ── Object store (MinIO on the server) ──────────────────────────────────────
# Where the bulk files live. DuckDB reads these over HTTP range requests, so a
# query transfers only the bytes it needs — nothing is downloaded whole.
# `tools/setup-object-store.sh` prints these filled in. The port here is the one
# PUBLISHED on the host (9012 for this project), never MinIO's internal 9000.
# Use the server's hostname — `localhost` is only correct while an SSH tunnel
# is open ON THIS MACHINE.
S3_ENDPOINT=your-server-hostname:9012
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mva

# Set false only while testing over plain HTTP on a trusted network.
S3_USE_SSL=true

# ── Source delivery ─────────────────────────────────────────────────────────
# Where the delivery sits on this machine; `source-scan/upload/status` default here.
MVA_SOURCE_DIR=/home/you/ubuntu/data

# Scratch directory `source-fetch --verify` downloads into, one file at a time.
MVA_STAGING_DIR=/home/you/mva-staging

# The gated Hugging Face dataset `source-fetch` pulls from; needs $HF_TOKEN access.
MVA_HF_REPO=SageBio/mva-hackathon-2026-data

# ── HTTP services ───────────────────────────────────────────────────────────
# Shared token for `mva-reads-api`, sent by clients as the `X-API-Key` header.
# Empty leaves the API open to anyone who can reach it — acceptable only on
# localhost or behind an SSH tunnel. `mva-viz-api` forwards this header upstream.
MVA_API_TOKEN=

# How many read-store queries `mva-reads-api` runs at once. A k-mer scan saturates
# the object-store link, so more workers make every query slower, not the set faster.
MVA_API_JOB_WORKERS=2

# Where `mva-viz-api` finds `mva-reads-api` for its /api/probe/* and /api/jobs/*
# proxy routes. Unreachable upstream is a 503, never a hang.
MVA_READS_API_URL=http://127.0.0.1:8765

# Browser origins `mva-viz-api` allows (comma-separated). The default is the Vite
# dev server on both spellings of loopback; add the deployed origin when it exists.
MVA_VIZ_CORS=http://localhost:5173,http://127.0.0.1:5173

# Where `mva-viz-api` writes its JSON response cache, relative to the working
# directory unless absolute. MUST stay gitignored: the locus endpoint's cache holds
# real patient positions. `build/` is already ignored, which is why this lives there.
MVA_VIZ_CACHE=build/viz-cache

# How long each dependency probe on GET /api/health/dependencies may take before it is
# reported `down`. Defaults are per check (see src/mva/viz/health_budget.py) because the
# probes cost wildly different amounts: pinging this process is not a Postgres greet over
# the WAN, nor a Parquet footer read through an SSH tunnel.
#
# MVA_HEALTH_TIMEOUT is a floor applied to every check — one knob for "this deployment is
# slow, give everything at least N seconds". It only raises budgets, never lowers them.
#MVA_HEALTH_TIMEOUT=20
#
# MVA_HEALTH_TIMEOUTS sets exact per-check values and wins over both the default and the
# floor, in either direction. Ids are the check ids the endpoint reports.
#MVA_HEALTH_TIMEOUTS=warehouse=25,object-store=15,reference-snapshots=30

# ── Track 1 oracle budget ───────────────────────────────────────────────────
# The scorer grants 6 submissions per registered team member. One member is
# registered for this team, so the budget is 6. Raise this only if more members
# actually register — it multiplies `mva.warehouse.probes.BUDGET`.
MVA_TEAM_MEMBERS=1
