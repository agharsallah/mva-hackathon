      "lincs"
    ],
    "k1_rule": {
      "do_not_moa": [
        "DNA ALKYLATING AGENT",
        "DNA CROSS-LINKING"
      ],
      "caution_moa": [
        "TOPOISOMERASE INHIBITOR",
        "DNA INTERCALATING AGENT",
        "DNA DAMAGE INDUCER",
        "DNA SYNTHESIS INHIBITOR",
        "DNA REPLICATION INHIBITOR",
        "RIBONUCLEOTIDE REDUCTASE INHIBITOR",
        "PARP INHIBITOR",
        "ATR KINASE INHIBITOR",
