# ── Challenge data ───────────────────────────────────────────────────────────
# The published dataset is 625 MB of CSV and is re-downloadable from the organisers, so
# the tree carries the recipe, not the files. Everything under `data/` is either raw
# input or derived from it; only the manifests that record HOW a table was derived are
# committed.
data/raw/
data/parquet/
data/*.csv
data/*.parquet
!data/manifests/
!data/manifests/*.json

.DS_Store
__pycache__/

# Python environments and build artifacts
.venv/
venv/
env/
*.egg-info/

# Derived output. Rebuilt by the pipeline, so the tree carries the recipe, not the
# result: caches, Parquet staging, Modal traces and ledgers all live here.
build/
*.duckdb
*.duckdb.wal

# Credentials. `.env.example` is the committed template; `.env` never is.
.env
.env.local
.env.*.local

# Vercel CLI project link (holds the project and org ids).
.vercel/

# Node / frontend. `app/` is a Vite app: the lockfile and sources are committed, the
# installed tree and the build output are not.
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
coverage/
