#!/usr/bin/env sh
# Husky pre-push hook — advisory only: it never blocks a push. The blocking gate is
# pre-commit; CI is the backstop. This hook re-runs the whole-tree gates that
# pre-commit scopes down (full vitest, the production build) on the pushed range and
# prints a warning when one is red, so a failure is seen before CI reports it.
#
# Root-level for the same reason as pre-commit (git resolves core.hooksPath from the
# repo top level, and this hook needs to see every ref being pushed). git passes one
# "<local ref> <local sha1> <remote ref> <remote sha1>" line per pushed ref on stdin;
# any ambiguous case (new branch, first-ever push) falls back to running the gate
# rather than silently skipping it.
#
# Skip it for one push: MVA_SKIP_PUSH_CHECKS=1 git push

zero=0000000000000000000000000000000000000000
run_gate=0
run_python=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue # deleting the ref — nothing to check

  if [ "$remote_sha" = "$zero" ]; then
    # New ref: no remote history to diff against. Compare to the merge-base with the
    # default remote branch; if even that is unavailable, diff the full tree.
    default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
    base=$(git merge-base "$local_sha" "$default_branch" 2>/dev/null || true)
    if [ -n "$base" ]; then
      changed=$(git diff --name-only "$base" "$local_sha")
    else
      empty_tree=$(git hash-object -t tree /dev/null)
      changed=$(git diff --name-only "$empty_tree" "$local_sha")
    fi
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)
  fi

  if printf '%s\n' "$changed" | grep -q '^app/'; then
    run_gate=1
  fi
  # The Python half: the package, its tests, its tooling, and the dependency pins.
  if printf '%s\n' "$changed" | grep -qE '^(src/|tests/|tools/|pyproject\.toml|uv\.lock)'; then
    run_python=1
  fi
done

if [ "${MVA_SKIP_PUSH_CHECKS:-0}" = "1" ]; then
  echo "pre-push: MVA_SKIP_PUSH_CHECKS=1 — skipping the advisory gates"
  exit 0
fi

if [ "$run_gate" = "0" ] && [ "$run_python" = "0" ]; then
  echo "pre-push: pushed range touches neither app/ nor the Python package — nothing to check"
  exit 0
fi

red=""

if [ "$run_python" = "1" ]; then
  echo "pre-push (advisory): running tools/check-python.sh"
  tools/check-python.sh || red="$red python"
fi

if [ "$run_gate" = "1" ]; then
  echo "pre-push (advisory): running pnpm run check + build in app/"
  (cd app && pnpm run check && pnpm run build) || red="$red app"
fi

if [ -n "$red" ]; then
  echo ""
  echo "pre-push: WARNING — red gate(s):$red. The push goes ahead; CI will report the same."
  echo "pre-push: fix it in a follow-up commit (the pre-commit hook blocks the next red commit)."
else
  echo "pre-push: every advisory gate is green"
fi
exit 0
