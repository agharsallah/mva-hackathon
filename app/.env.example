# Base URL of mva-viz-api (FastAPI). Default when unset: http://127.0.0.1:8900
VITE_API_URL=http://127.0.0.1:8900

# "false" disables the committed fixture fallback, so an unreachable API surfaces as an error.
# Anything else (or unset) keeps the fallback on and shows a "fixture data" badge in the header.
VITE_USE_FIXTURES=true
