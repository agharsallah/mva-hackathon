{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/test/**",
    "tools/**",
    "eslint.config.js",
    "eslint-rules/**",
    "middleware.ts",
    "api/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tools/**/*.{ts,js,mjs}",
    "eslint-rules/**/*.js",
    "middleware.ts",
    "api/**/*.ts",
    "server/**/*.ts"
  ]
}
