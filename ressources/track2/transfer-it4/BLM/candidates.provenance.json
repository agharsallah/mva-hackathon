        "TOP1",
        "TOP2A",
        "TOP2B"
      ],
      "moa_source": "Drug Repurposing Hub MOA field (PRISM compound annotation)",
      "source_entry": "PMID 20301572 (GeneReviews, Bloom syndrome, updated 2023): 'Alkylating agents and radiation therapy are considered high risk and are avoided when possible'; 'dose reductions and shortened courses of chemotherapy when needed'. Do-not = the alkylating class; caution = the other DNA-damaging and replication-stress classes (Repurposing Hub MOA vocabulary)",
      "rule": "fail when the annotated MOA contains a do_not_moa phrase; caution when it contains a caution_moa phrase, when the drug has no MOA annotation, or when its annotated targets include a checkpoint_targets symbol the MOA does not name; pass otherwise"
    },
    "k3_rule": {
      "direction_contrasts": {
        "D2": [
          "lohfraction"
        ],
        "D4": [
          "rms"
        ]
      },
      "alpha": 0.05,
      "rule": "fail when, on a contrast the drug's direction maps to, Cliff's delta < 0 and the one-sided p that the in-group is LESS sensitive < alpha; pass (not applicable) when no direction maps to a contrast or the drug is not measured"
    },
    "k3_sweep_columns": {
      "drug": "drug",
      "contrast": "contrast",
      "delta": "cliffs_delta",
      "p": "p_raw",
      "p_opposite": "p_opposite",
      "only_column": "representative",
      "only_value": "true"
    },
    "k2_faers_scope": "converging",
    "k2_faers_rule": "every drug in scope x every MedDRA PT with used_for_flag = yes"
  },
