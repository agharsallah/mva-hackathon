# Copy to `.env` and fill in what you need. `.env` is gitignored and must stay that way.
#
# Anything exported in your real environment WINS over this file, so CI can inject a
# token without a stale `.env` overriding it. Every key below, with its default, is
# declared in `src/sepiq/settings.py` — that module is the single source of truth.

# ── Data ────────────────────────────────────────────────────────────────────
# The challenge files as published. Gitignored: 625 MB of CSV does not belong in git,
# and `data/raw/` is reproducible by re-downloading from the organisers.
RAW_DIR=data/raw

# Derived Parquet, and the provenance manifest written beside every derived table.
PARQUET_DIR=data/parquet
MANIFEST_DIR=data/manifests

# ── HTTP service (`sepiq-api`) ────────────────────────────────────────────────
# Shared token, sent by clients as the `X-API-Key` header. Empty leaves the API open,
# which is correct on loopback and nowhere else; `sepiq-api` refuses a non-loopback bind
# while this is empty. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Browser origins the API allows (comma-separated). The default is the Vite dev server on
# both spellings of loopback — to a browser `localhost` and `127.0.0.1` are DIFFERENT
# origins, which is why both are listed. Any loopback port is allowed on top of this.
API_CORS=http://localhost:5173,http://127.0.0.1:5173

# Where the API writes its JSON response cache, relative to the working directory unless
# absolute. Keep it under gitignored `build/`: a cache entry is a derived artifact.
API_CACHE=build/api-cache

# ── Optional upstream ───────────────────────────────────────────────────────
# A service the API forwards job-shaped verbs to instead of reimplementing them. Leave
# empty when there is none; an unreachable upstream is a 503, never a hang.
UPSTREAM_URL=
